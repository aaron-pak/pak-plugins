{
  "element_overflow": [
    {
      "on": ".sk-page, .sk-hero",
      "wider": true
    },
    {
      "on": ".sk-slide",
      "wider": true,
      "taller": true
    },
    {
      "on": ".sk-sr, .sk-sr *",
      "wider": true,
      "taller": true
    },
    {
      "on": ".sk-code code, .sk-code code *",
      "wider": true
    },
    {
      "on": ".sk-terminal code, .sk-terminal code *",
      "wider": true
    },
    {
      "on": "[class^='sk-'], [class*=' sk-'], .sk-page section, .sk-page div, .sk-steps > li",
      "taller": 24
    },
    {
      "on": ":has(> .sk-sticky)",
      "wider": 48,
      "taller": 48
    }
  ],
  "contrast": [
    {
      "on": ".sk-btn",
      "least": 4
    },
    {
      "on": ".sk-label",
      "least": 3.8
    },
    {
      "on": "time",
      "least": 4.3
    },
    {
      "on": ".sk-tl-ps, .sk-tl-note",
      "least": 3.4
    },
    {
      "on": ".sk-tasks li:has(:checked) .sk-pill",
      "least": 1.8
    }
  ]
}
